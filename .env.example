# Copia este archivo a .env (scripts\setup.ps1 lo hace y genera claves aleatorias).
# NUNCA subas .env al repositorio.

APP_ENV=development
INSTITUTION_NAME=Institución de Salud (configurar en el panel)
LOG_LEVEL=INFO

# Seguridad: en producción debe ser aleatoria y de 32+ caracteres
SECRET_KEY=cambiar-esta-clave
# Clave Fernet para cifrar datos personales (documentos). Obligatoria en producción; si se pierde,
# esos datos no se pueden recuperar. Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# PostgreSQL (docker-compose usa estas variables para crear la base)
POSTGRES_USER=recep
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=recep_salud
POSTGRES_PORT=5432
# Para ejecutar la API fuera de Docker. Dentro de Docker, compose lo reemplaza.
DATABASE_URL=postgresql+psycopg://recep:cambiar-esta-clave@127.0.0.1:5432/recep_salud

# LLM (Ollama local; para API externa: LLM_PROVIDER=openai_compatible + LLM_API_BASE + LLM_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b-it-qat

# Embeddings: la dimensión DEBE coincidir con la columna vector (medida: 768)
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_DIMENSIONS=768

# Voz a texto (faster-whisper). El modelo se usa sin conexión desde STT_MODELS_DIR. GPU opcional: STT_DEVICE=auto + STT_CUDA_DLL_DIRS=<carpetas bin de cuBLAS/cuDNN de CUDA 12 separadas por ;> (sin ellas, CPU)
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Texto a voz: auto = Piper si está el archivo de voz, si no la voz de Windows (solo Windows). Ninguna voz es colombiana.
TTS_MOTOR=auto
TTS_PIPER_MODELO=data/models/tts/piper/es_MX-claude-high.onnx
TTS_VELOCIDAD=1.0

# Avisos a pacientes por correo (Fase 15). Sin SMTP_HOST los avisos quedan registrados como omitidos (nadie los recibe).
# No hay proveedor de SMS ni de WhatsApp. Nunca subas la clave al repositorio.
NOTIFICACIONES_ACTIVAS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
SMTP_STARTTLS=true
RECORDATORIO_HORAS_ANTES=24

# Despliegue con HTTPS (docker compose --profile produccion up -d). localhost = certificado local de Caddy; un dominio real = Let's Encrypt.
DOMINIO=localhost
# En producción: APP_ENV=production, CORS_ORIGINS=["https://tu-dominio"], SECRET_KEY y DATA_ENCRYPTION_KEY reales (¡respáldalas aparte!).

# Retención (0 = nunca borrar). Son valores iniciales, NO un criterio legal: fíjalos con tu asesor jurídico.
RETENCION_AVISOS_DIAS=90
RETENCION_CONVERSACIONES_DIAS=365
RETENCION_PRUEBAS_DIAS=30
STT_CUDA_DLL_DIRS=
